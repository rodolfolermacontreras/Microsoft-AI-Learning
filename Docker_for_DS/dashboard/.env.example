# LLM Backend Configuration
# Copy to .env and fill in your values.

# ---- Option A: OpenAI (recommended) ----
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ---- Option B: Azure OpenAI ----
# AZURE_OPENAI_KEY=your-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# ---- Option C: GitHub Copilot SDK ----
# Requires `copilot` CLI installed and authenticated
# COPILOT_SDK=true
# COPILOT_MODEL=gpt-4.1

# ---- Dashboard Settings ----
# Chat history window (number of messages to keep in context)
CHAT_HISTORY_LENGTH=20

# Allow real Docker commands in the playground (true/false)
# Set to false for a pure simulation/learning environment
ALLOW_REAL_DOCKER=true
